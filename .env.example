# Local development only. Never commit real secrets.
NODE_ENV=development
LOG_LEVEL=info

API_PORT=5000
DATABASE_URL=postgres://localstock:localstock_dev_password@localhost:5432/localstock
# Integration tests use their own database (created and emptied automatically; name must end in _test).
# Defaults to DATABASE_URL with "_test" appended to the database name.
# TEST_DATABASE_URL=postgres://localstock:localstock_dev_password@localhost:5432/localstock_test
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://localstock:localstock_dev_password@localhost:5672

JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

RESERVATION_TTL_SECONDS=600
MAX_CANDIDATE_RADIUS_KM=50
PAYMENT_WEBHOOK_SECRET=dev-only-sandbox-webhook-secret

OUTBOX_POLL_INTERVAL_MS=1000
RESERVATION_EXPIRY_INTERVAL_MS=15000
RECONCILIATION_INTERVAL_MS=300000

# ---------------------------------------------------------------- external platform sources
# See docs/platforms/. LocalStock has no authorized access to any of these platforms, so
# their connectors stay disabled (SOURCE_NOT_CONFIGURED) whatever these flags say until an
# approved adapter exists. Credentials for an approved source are added only once the
# agreement documents them. Never put cookies or personal account tokens here.
EXTERNAL_SOURCE_TIMEOUT_MS=4000
EXTERNAL_SEARCH_MAX_CONCURRENCY=4
BLINKIT_ENABLED=false
ZEPTO_ENABLED=false
INSTAMART_ENABLED=false
BIGBASKET_ENABLED=false

# Licensed data provider: only one with platform authorization and display rights (see
# docs/platforms/providers-and-ondc.md). The mapping file is written from the provider's docs.
LICENSED_PROVIDER_ENABLED=false
LICENSED_PROVIDER_CODE=
LICENSED_PROVIDER_NAME=
LICENSED_PROVIDER_BASE_URL=
LICENSED_PROVIDER_API_KEY=
LICENSED_PROVIDER_MAPPING_FILE=
LICENSED_PROVIDER_PLATFORMS=

# Development only: a fictional "Demo Quick-Commerce (fixture data)" source. Refused when
# NODE_ENV=production.
DEMO_EXTERNAL_FIXTURES=false