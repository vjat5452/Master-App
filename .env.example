# Local development only. Never commit real secrets.
NODE_ENV=development
LOG_LEVEL=info

API_PORT=5000
DATABASE_URL=postgres://localstock:localstock_dev_password@localhost:5432/localstock
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://localstock:localstock_dev_password@localhost:5672

JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

RESERVATION_TTL_SECONDS=600
MAX_CANDIDATE_RADIUS_KM=50
PAYMENT_WEBHOOK_SECRET=dev-only-sandbox-webhook-secret

OUTBOX_POLL_INTERVAL_MS=1000
RESERVATION_EXPIRY_INTERVAL_MS=15000
RECONCILIATION_INTERVAL_MS=300000
