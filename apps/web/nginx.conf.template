# Serves the built single-page app and forwards API calls to the API container, so the
# browser sees one origin (the API does not enable CORS). API_UPSTREAM is substituted by the
# nginx image at start, e.g. http://api:5000.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Server-sent events: no buffering, long-lived.
  location /api/v1/discovery/stream {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_http_version 1.1;
    proxy_set_header Connection '';
    proxy_buffering off;
    proxy_read_timeout 1h;
  }

  location /health/ {
    proxy_pass ${API_UPSTREAM};
  }

  # Hashed build assets can be cached forever; index.html never.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-cache";
  }
}
