# Serves the built single-page app and forwards API calls to the API container, so the
# browser sees one origin (the API does not enable CORS). API_UPSTREAM and PORT are
# substituted by the nginx image at start, e.g. http://api:5000 and 8080.
#
# The upstream is held in a variable so nginx re-resolves its name (every 10 s, with the
# container's own DNS servers) instead of once at start: on hosts like Railway the API's
# private address changes when it is redeployed.
server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;

  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
  set $api_upstream ${API_UPSTREAM};

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  location /api/ {
    proxy_pass $api_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Server-sent events: no buffering, long-lived.
  location /api/v1/discovery/stream {
    proxy_pass $api_upstream;
    proxy_set_header Host $host;
    proxy_http_version 1.1;
    proxy_set_header Connection '';
    proxy_buffering off;
    proxy_read_timeout 1h;
  }

  location /health/ {
    proxy_pass $api_upstream;
  }

  # Hashed build assets can be cached forever; index.html never.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-cache";
  }
}
